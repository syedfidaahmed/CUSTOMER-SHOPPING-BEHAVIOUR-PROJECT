#6).Which 5 products have the highest percentage of purchases with discount applied?

SELECT
item_purchased,
round(
  sum(case WHEN 
      discount_applied='Yes' then 1 else 0 end)* 100.0/ count(*),2)
      as discount_percentage
  from customer
  group by item_purchased
