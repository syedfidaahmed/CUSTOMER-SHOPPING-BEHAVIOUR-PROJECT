 #8). What are the top 3 most purchased products within each category
 
 SELECT *
FROM (
    SELECT item_purchased, category,
           COUNT(*) AS total,
           ROW_NUMBER() OVER (
               PARTITION BY category
               ORDER BY COUNT(*) DESC
           ) AS ranking
    FROM customer
    GROUP BY item_purchased, category
) AS t
WHERE ranking <= 3;

'Analysis: Jewlery is the most purcchased product in accesories(170 PURCHASES),while blouse leads clothing(169).
Sandals lead footwear(159),and jacket leads outerwear(163).'

#9).Are customers who are repeat buyers(more than 5 previous purchases) also likely to subscribe?

SELECT
    CASE
        WHEN previous_purchas > 5 THEN 'Repeat Buyers'
        ELSE 'Other Customers'
    END AS customer_type,

    COUNT(*) AS total_customers,

    SUM(CASE
        WHEN subscription_sta = 'Yes' THEN 1
        ELSE 0
    END) AS subscribers,

    ROUND(
        100.0 * SUM(CASE
            WHEN subscription_sta = 'Yes' THEN 1
            ELSE 0
        END) / COUNT(*), 2
    ) AS subscription_rate

FROM customer
GROUP BY customer_type;

'Analysis: Repeat buyers have a higher subscription rate (27.28%) compared to other customers (22.33%).
This suggests that customers with more than 5 previous purchases are more likely to subscribe, indicating a positive relationship between repeat purchases and subscriptions.'

#Q10). What is the revenue generation of each GROUP

SELECT
CASE
when age>=55 then 'senior citizen'
when age>=18 and age<55 then 'adult'
else 'teen'
end as age_group,
sum(purchase_amount) as total_revenue
from customer
group by age_group;

'Analysis: Adults generate the highest revenue(161,790),significantly exceeding senior citizens(68,839).
This indicates that adults contribute the largest and teenagers have no share in total revenue.'